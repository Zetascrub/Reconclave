#!/bin/sh
set -eu

output=${1:-}
if [ -z "$output" ]; then
    directory=/root/reconclave/evidence
    mkdir -p "$directory"
    output="$directory/ui-$(date +%Y%m%d-%H%M%S).png"
fi

case "$output" in
    /*.png) ;;
    *) echo "Usage: reconclave-screenshot [/absolute/path.png]" >&2; exit 2 ;;
esac

mkdir -p "$(dirname "$output")"
temporary="${output}.tmp.png"
trap 'rm -f "$temporary"' EXIT INT TERM

# The K230 scanout plane is RGB565. KMS grab reads the exact active DRM
# framebuffer even while the LVGL UI owns the display; the two format stages
# download it from DRM and encode a portable, lossless RGB PNG.
ffmpeg -hide_banner -loglevel error \
    -f kmsgrab -device /dev/dri/card0 -i - \
    -vf 'hwdownload,format=rgb565le,format=rgb24' \
    -frames:v 1 -y "$temporary"
mv "$temporary" "$output"
trap - EXIT INT TERM
printf '%s\n' "$output"
