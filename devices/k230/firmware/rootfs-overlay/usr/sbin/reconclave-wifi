#!/bin/sh
set -eu

CONF=/etc/reconclave/wpa_supplicant.conf
IFACE=wlan0

usage() {
	echo "Usage: reconclave-wifi SSID [PASSWORD]" >&2
	echo "If PASSWORD is omitted it is read without echo." >&2
	exit 2
}

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
ssid=$1
password=${2:-}
if [ "$#" -eq 1 ]; then
	if [ -t 0 ]; then
		printf 'Wi-Fi password: ' >&2
		stty -echo
		IFS= read -r password
		stty echo
		printf '\n' >&2
	else
		IFS= read -r password
	fi
fi
[ "${#password}" -ge 8 ] || { echo "Password must be at least 8 characters." >&2; exit 2; }

umask 077
mkdir -p /etc/reconclave
tmp="${CONF}.new.$$"
trap 'rm -f "$tmp"; stty echo 2>/dev/null || true' EXIT INT TERM
{
	echo 'ctrl_interface=/var/run/wpa_supplicant'
	echo 'update_config=0'
	wpa_passphrase "$ssid" "$password" | sed '/^[[:space:]]*#psk=/d'
} >"$tmp"
mv "$tmp" "$CONF"
trap - EXIT INT TERM

ifdown "$IFACE" 2>/dev/null || true
ifconfig "$IFACE" up
ifup "$IFACE"
echo "Wi-Fi profile installed for $ssid."
ip -4 addr show dev "$IFACE" 2>/dev/null || true
