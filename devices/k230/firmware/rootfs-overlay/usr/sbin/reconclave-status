#!/bin/sh

echo "Reconclave K230 status"
echo "Hostname: $(hostname 2>/dev/null || echo unknown)"
echo "Kernel: $(uname -sr 2>/dev/null || echo unknown)"
echo "Uptime: $(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)s"

echo
echo "Network:"
ip -brief -4 address show 2>/dev/null || ifconfig 2>/dev/null || true
ip route show default 2>/dev/null || true

echo
echo "Services:"
for service in reconclave-k230-node reconclave-k230-ui; do
	if pidof "$service" >/dev/null 2>&1; then
		echo "  $service: running (pid $(pidof "$service"))"
	else
		echo "  $service: stopped"
	fi
done
if pidof sshd >/dev/null 2>&1; then
	echo "  sshd: running on port 22 (public-key only)"
else
	echo "  sshd: stopped"
fi

echo
/usr/sbin/reconclave-trust status 2>/dev/null || echo "Execution trust: unavailable"

echo
echo "Storage:"
df -h / /root/reconclave 2>/dev/null | awk 'NR == 1 || !seen[$1]++'

echo
echo "Power:"
power_found=0
if [ -r /run/reconclave/battery-status ]; then
	power_found=1
	sed 's/^/  /' /run/reconclave/battery-status
fi
for supply in /sys/class/power_supply/*; do
	[ -d "$supply" ] || continue
	power_found=1
	name=$(basename "$supply")
	type=$(cat "$supply/type" 2>/dev/null || echo unknown)
	capacity=$(cat "$supply/capacity" 2>/dev/null || true)
	status=$(cat "$supply/status" 2>/dev/null || true)
	printf '  %s (%s)' "$name" "$type"
	[ -n "$capacity" ] && printf ': %s%%' "$capacity"
	[ -n "$status" ] && printf ' %s' "$status"
	echo
done
[ "$power_found" -eq 1 ] || echo "  Keyboard-base gauge not detected."

echo
echo "GNSS:"
if [ -r /run/reconclave/gnss-status ]; then
	sed 's/^/  /' /run/reconclave/gnss-status
else
	echo "  Runtime status unavailable."
fi

echo
echo "Recent errors:"
for log in /var/log/reconclave-k230-node.log /var/log/reconclave-k230-ui.log; do
	[ -s "$log" ] || continue
	echo "  $log"
	tail -n 5 "$log" | sed 's/^/    /'
done
