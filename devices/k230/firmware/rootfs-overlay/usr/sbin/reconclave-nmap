#!/bin/sh
set -eu
target=${1:-}
preset=${2:-discovery}
evidence_dir=/root/reconclave/evidence
case "$target" in ''|*[!0-9./]*) echo "Usage: reconclave-nmap IPv4_OR_CIDR [discovery|quick|services]" >&2; exit 2;; esac
case "$preset" in
  discovery) set -- -sn -n -T4 --max-retries 1 --host-timeout 8s;;
  quick) set -- -sT -n -T4 --top-ports 100 --open --max-retries 1 --host-timeout 30s;;
  services) set -- -sT -sV --version-light -n -T3 --top-ports 50 --open --max-retries 1 --host-timeout 45s;;
  *) echo "Preset must be discovery, quick or services" >&2; exit 2;;
esac
command -v nmap >/dev/null 2>&1 || { echo "nmap is not installed" >&2; exit 127; }
mkdir -p "$evidence_dir"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
output="$evidence_dir/nmap-${preset}-${stamp}.txt"
umask 077
printf 'Reconclave Nmap // %s // %s\n\n' "$preset" "$target" | tee "$output"
raw="${output}.partial"
nmap "$@" "$target" >"$raw" 2>&1 &
scan_pid=$!
elapsed=0
while kill -0 "$scan_pid" 2>/dev/null && [ "$elapsed" -lt 120 ]; do
  sleep 1
  elapsed=$((elapsed + 1))
done
if kill -0 "$scan_pid" 2>/dev/null; then kill -INT "$scan_pid" 2>/dev/null || true; fi
status=0
wait "$scan_pid" || status=$?
cat "$raw" | tee -a "$output"
rm -f "$raw"
printf '\nSAVED %s\n' "$output"
exit "$status"
