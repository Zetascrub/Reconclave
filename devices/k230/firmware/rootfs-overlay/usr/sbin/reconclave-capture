#!/bin/sh
set -eu

iface=${1:-}
duration=${2:-30}
preset=${3:-all}
evidence_dir=/root/reconclave/evidence

case "$iface" in
	''|*[!A-Za-z0-9_.:-]*) echo "Usage: reconclave-capture INTERFACE [1-300] [all|arp|dns|dhcp]" >&2; exit 2 ;;
esac
[ -d "/sys/class/net/$iface" ] || { echo "Unknown interface: $iface" >&2; exit 2; }
case "$duration" in ''|*[!0-9]*) echo "Duration must be 1-300 seconds" >&2; exit 2;; esac
[ "$duration" -ge 1 ] && [ "$duration" -le 300 ] || { echo "Duration must be 1-300 seconds" >&2; exit 2; }

case "$preset" in
	all) set -- ;;
	arp) set -- arp ;;
	dns) set -- port 53 ;;
	dhcp) set -- port 67 or port 68 ;;
	*) echo "Preset must be all, arp, dns or dhcp" >&2; exit 2 ;;
esac

command -v tcpdump >/dev/null 2>&1 || { echo "tcpdump is not installed in this image" >&2; exit 127; }
mkdir -p "$evidence_dir"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
final="$evidence_dir/capture-${iface}-${preset}-${stamp}.pcap"
partial="${final}.partial"
umask 077
tcpdump -i "$iface" -U -s 262144 -w "$partial" "$@" >/dev/null 2>&1 &
pid=$!
cleanup() {
	kill -INT "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
}
trap cleanup INT TERM EXIT
sleep "$duration"
cleanup
trap - INT TERM EXIT
mv "$partial" "$final"
printf '%s\n' "$final"
