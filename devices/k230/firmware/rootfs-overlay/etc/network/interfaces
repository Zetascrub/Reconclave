auto lo
iface lo inet loopback

# A cable is the zero-configuration recovery and first-setup route.
auto eth0
iface eth0 inet dhcp
	metric 200
	pre-up /etc/network/nfs_check
	wait-delay 15
	hostname $(hostname)

# Wi-Fi is enabled after a profile is created with `reconclave-wifi`.
auto wlan0
iface wlan0 inet dhcp
	metric 100
	pre-up test -s /etc/reconclave/wpa_supplicant.conf
	pre-up mkdir -p /var/run/wpa_supplicant
	pre-up wpa_supplicant -B -i wlan0 -D nl80211,wext -c /etc/reconclave/wpa_supplicant.conf
	post-down killall -q wpa_supplicant || true
