{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconclave.dev/schemas/reconclave-1-announce.json",
  "title": "Reconclave v1 announcement payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "device_type", "firmware", "roles", "capabilities", "status"],
  "properties": {
    "device_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "device_type": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "firmware": { "type": "string", "minLength": 1, "maxLength": 32 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "contains": { "const": "node" },
      "items": { "enum": ["node", "coordinator", "analysis"] }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 96, "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$" }
    },
    "capability_descriptors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "permission"],
        "properties": {
          "id": { "type": "string", "maxLength": 96, "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$" },
          "version": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "permission": { "enum": ["public", "trusted"] },
          "features": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" } },
          "limits": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
              "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 1024 }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network_mbps": { "type": "integer", "minimum": 0 },
        "persistent_storage": { "type": "boolean" },
        "storage_free_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "status": { "enum": ["ready", "busy", "degraded"] }
    ,
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paired", "boot_nonce", "mode"],
      "properties": {
        "paired": { "type": "boolean" },
        "boot_nonce": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "mode": { "enum": ["hmac-sha256-128", "provisioned-hmac-sha256-128"] },
        "trusted_coordinators": { "type": "integer", "minimum": 0, "maximum": 255 },
        "primary_coordinator": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "coordinator_priority": { "type": "integer", "minimum": 0, "maximum": 255 },
        "active_coordinator": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "active_priority": { "type": "integer", "minimum": 0, "maximum": 255 },
        "lease_remaining_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    }
  }
}
