{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reconclave.dev/schemas/reconclave-1-request.json",
  "title": "Reconclave v1 capability request payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "capability", "arguments"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "capability": { "type": "string", "maxLength": 96, "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$" },
    "arguments": { "type": "object" },
    "auth": { "$ref": "#/$defs/auth" }
  },
  "$defs": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce", "tag"],
      "properties": {
        "nonce": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "coordinator_priority": { "type": "integer", "minimum": 0, "maximum": 255 },
        "lease_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "tag": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
      }
    }
  }
}
